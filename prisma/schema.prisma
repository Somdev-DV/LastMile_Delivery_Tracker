generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  DELIVERY_AGENT
  ADMIN
}

enum AgentAvailability {
  AVAILABLE
  BUSY
  OFFLINE
}

enum OrderType {
  B2B
  B2C
}

enum PaymentType {
  PREPAID
  COD
}

enum RouteType {
  INTRA_ZONE
  INTER_ZONE
}

enum OrderStatus {
  CREATED
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RESCHEDULED
  CANCELLED
}

enum NotificationChannel {
  EMAIL
  SMS
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum AssignmentMethod {
  MANUAL
  AUTO
}

enum AttemptStatus {
  ACTIVE
  COMPLETED
  FAILED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  phone     String?
  role      Role     @default(CUSTOMER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customerProfile CustomerProfile?
  agentProfile    DeliveryAgent?
  orders          Order[]          @relation("CustomerOrders")
  trackingEvents  TrackingEvent[]  @relation("ActorEvents")
  notifications   Notification[]
}

model CustomerProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  address   String?
  city      String?
  pincode   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model DeliveryAgent {
  id           String            @id @default(uuid())
  userId       String            @unique
  availability AgentAvailability @default(AVAILABLE)
  latitude     Float?
  longitude    Float?
  zoneId       String?
  vehicleType  String?
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  user        User                 @relation(fields: [userId], references: [id])
  zone        Zone?                @relation(fields: [zoneId], references: [id])
  assignments DeliveryAssignment[]
  attempts    DeliveryAttempt[]
  orders      Order[]              @relation("AgentOrders")

  @@index([availability])
  @@index([zoneId])
}

model Zone {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  areas        Area[]
  agents       DeliveryAgent[]
  pickupOrders Order[]    @relation("PickupZone")
  dropOrders   Order[]    @relation("DropZone")
  rateCards    RateCard[]
}

model Area {
  id        String   @id @default(uuid())
  name      String
  pincode   String
  city      String?
  zoneId    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  zone Zone @relation(fields: [zoneId], references: [id])

  @@unique([pincode])
  @@index([zoneId])
  @@index([pincode])
}

model RateCard {
  id        String    @id @default(uuid())
  zoneId    String?
  orderType OrderType
  routeType RouteType
  baseRate  Float
  perKgRate Float
  minWeight Float     @default(0.5)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  zone Zone? @relation(fields: [zoneId], references: [id])

  @@index([orderType, routeType])
}

model CodSurcharge {
  id          String    @id @default(uuid())
  orderType   OrderType
  percentage  Float
  flatAmount  Float     @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([orderType])
}

model Order {
  id               String      @id @default(uuid())
  orderNumber      String      @unique
  customerId       String
  pickupAddress    String
  pickupPincode    String
  pickupCity       String?
  dropAddress      String
  dropPincode      String
  dropCity         String?
  pickupZoneId     String?
  dropZoneId       String?
  length           Float
  breadth          Float
  height           Float
  actualWeight     Float
  volumetricWeight Float
  billableWeight   Float
  orderType        OrderType
  paymentType      PaymentType
  codAmount        Float?
  baseRate         Float?
  weightCharge     Float?
  codSurcharge     Float?
  calculatedCharge Float?
  status           OrderStatus @default(CREATED)
  assignedAgentId  String?
  remarks          String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  customer           User                 @relation("CustomerOrders", fields: [customerId], references: [id])
  pickupZone         Zone?                @relation("PickupZone", fields: [pickupZoneId], references: [id])
  dropZone           Zone?                @relation("DropZone", fields: [dropZoneId], references: [id])
  assignedAgent      DeliveryAgent?       @relation("AgentOrders", fields: [assignedAgentId], references: [id])
  trackingEvents     TrackingEvent[]
  assignments        DeliveryAssignment[]
  attempts           DeliveryAttempt[]
  notifications      Notification[]
  rescheduleRequests RescheduleRequest[]

  @@index([customerId])
  @@index([status])
  @@index([pickupZoneId])
  @@index([dropZoneId])
  @@index([assignedAgentId])
  @@index([createdAt])
}

model TrackingEvent {
  id         String       @id @default(uuid())
  orderId    String
  prevStatus OrderStatus?
  newStatus  OrderStatus
  actorId    String
  actorRole  Role
  remarks    String?
  timestamp  DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id])
  actor User  @relation("ActorEvents", fields: [actorId], references: [id])

  @@index([orderId])
  @@index([timestamp])
}

model DeliveryAssignment {
  id         String           @id @default(uuid())
  orderId    String
  agentId    String
  method     AssignmentMethod
  reasoning  String?
  assignedAt DateTime         @default(now())
  releasedAt DateTime?
  isActive   Boolean          @default(true)

  order Order         @relation(fields: [orderId], references: [id])
  agent DeliveryAgent @relation(fields: [agentId], references: [id])

  @@index([orderId])
  @@index([agentId])
}

model DeliveryAttempt {
  id            String        @id @default(uuid())
  orderId       String
  agentId       String
  attemptNumber Int
  status        AttemptStatus @default(ACTIVE)
  failureReason String?
  scheduledDate DateTime?
  startedAt     DateTime      @default(now())
  completedAt   DateTime?
  createdAt     DateTime      @default(now())

  order Order         @relation(fields: [orderId], references: [id])
  agent DeliveryAgent @relation(fields: [agentId], references: [id])

  @@index([orderId])
  @@index([agentId])
}

model RescheduleRequest {
  id            String   @id @default(uuid())
  orderId       String
  requestedDate DateTime
  reason        String?
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

model Notification {
  id        String              @id @default(uuid())
  orderId   String
  userId    String
  channel   NotificationChannel
  event     String
  status    NotificationStatus  @default(PENDING)
  message   String
  sentAt    DateTime?
  createdAt DateTime            @default(now())

  order Order @relation(fields: [orderId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@index([orderId])
  @@index([userId])
}
